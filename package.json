{
  "name": "ghulo-milo",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@eslint/js": "9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.1.1",
    "auth": "^1.7.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "^7.0.0",
    "wrangler": "^4.146.0"
  },
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs --seed",
    "predev": "node scripts/setup.mjs --quiet",
    "dev": "vite",
    "dev:ai": "REMOTE_BINDINGS=true vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && node scripts/setup.mjs --quiet && vite preview",
    "lint": "eslint .",
    "check": "tsc -b && vite build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --strict-vars=false",
    "auth:generate": "auth generate --config auth.config.ts --output src/worker/db/auth-schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:gen-seed": "node scripts/gen-taxonomy-sql.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "db:reset:local": "rm -rf .wrangler/state && npm run setup",
    "test:e2e": "node scripts/e2e.mjs",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "type": "module"
}
