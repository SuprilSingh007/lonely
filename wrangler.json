/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ghulo-milo",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		// Send /api/* straight to the Worker, even for browser navigations.
		"run_worker_first": ["/api/*"]
	},
	/**
	 * D1 holds all app data (auth, profiles, taxonomy, swipes, chats).
	 * Migrations live in ./migrations (generated by drizzle-kit).
	 * Before the first deploy: `npx wrangler d1 create ghulo-milo` and paste the id below.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ghulo-milo",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * One ChatRoom Durable Object per conversation fans out real-time events
	 * over hibernatable WebSockets.
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ChatRoom"]
		}
	],
	/**
	 * Workers AI writes profile summaries and opening lines. It always runs remotely,
	 * so local dev without `wrangler login` falls back to built-in templates.
	 */
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"APP_NAME": "Ghulo Milo",
		// "console" prints OTPs to the Worker log and the dev-only OTP inbox; "twilio" sends real SMS.
		"SMS_PROVIDER": "console",
		// Comma-separated E.164 numbers that get the admin role on sign-in.
		"ADMIN_PHONE_NUMBERS": "+919999999999",
		"AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
		"DAILY_SWIPE_LIMIT": "20"
	}
}
